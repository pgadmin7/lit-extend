{
  "name": "vue-ts",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "type": "module",
  "wireit": {
    "dev": {
      "command": "vite dev --force",
      "service": true
    },
    "build": {
      "command": "vue-tsc -b && vite build",
      "clean": true,
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "vite-config.mts"
      ],
      "output": [
        "dist",
        ".tsbuildinfo"
      ]
    },
    "preview": {
      "command": "vite preview",
      "service": true
    }
  },
  "dependencies": {
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "vue-tsc": "^3.2.2"
  },
  "peerDependencies": {}
}
