{
  "name": "lit-ts",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "type": "module",
  "wireit": {
    "dev": {
      "command": "vite dev --force",
      "service": true,
      "env": {
        "NODE_ENV": "development"
      }
    },
    "build": {
      "command": "vite build",
      "clean": true,
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "vite-config.mts"
      ],
      "output": [
        "dist",
        ".tsbuildinfo"
      ]
    },
    "preview": {
      "command": "vite preview",
      "service": true
    }
  },
  "dependencies": {
    "lit": "^3.3.2",
    "@yiin/reactive-proxy-state": "^1.0.28",
    "ol": "^10.7.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "autoprefixer": "^10.4.23",
    "core-js":"^3.48.0",
    "@types/core-js":"^2.5.8",
    "terser":"^5.46.0"
  },
  "peerDependencies": {}
}
